# Docker Model Runner for LLM inference (OpenAI-compatible API).
# Requires Docker Desktop with Model Runner enabled and model pulled:
#   docker model pull ai/gpt-oss:120B-UD-Q4_K_XL
#
# For embeddings, requires Ollama running on the host:
#   ollama pull nomic-embed-text

# Default user scope for memories (optional, defaults to "default").
MEM0_DEFAULT_USER_ID=default

# Required by openmemory-mcp's categorization module (hardcoded OpenAI client).
# Routed to Docker Model Runner's OpenAI-compatible API.
OPENAI_API_KEY=docker
OPENAI_BASE_URL=http://model-runner.docker.internal/engines/v1

# Mem0 LLM - via Docker Model Runner
LLM_PROVIDER=openai
LLM_MODEL=ai/gpt-oss:120B-UD-Q4_K_XL
OPENAI_API_BASE=http://model-runner.docker.internal/engines/v1

# Embeddings - Docker Model Runner doesn't provide embeddings, use nomic via Ollama
EMBEDDER_PROVIDER=ollama
EMBEDDER_MODEL=nomic-embed-text-v2-moe
EMBEDDER_MODEL_DIMS=768
OLLAMA_BASE_URL=http://host.docker.internal:11434
