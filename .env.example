# --- Provider: OpenAI (default) ---
# Requires an OpenAI API key. Used for memory extraction and embeddings.
OPENAI_API_KEY=sk-your-openai-api-key-here
USER=default

# --- Provider: Ollama (fully offline) ---
# Uncomment these and remove OPENAI_API_KEY to go fully local.
# Requires Ollama running on the host with models pulled:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
#
# OPENAI_API_KEY=not-needed
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:latest
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# EMBEDDER_PROVIDER=ollama
# EMBEDDER_MODEL=nomic-embed-text
# EMBEDDER_MODEL_DIMS=768
